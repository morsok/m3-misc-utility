# Mylar3 connection
MYLAR_HOST=localhost
MYLAR_PORT=8090
MYLAR_APIKEY=your_api_key_here
MYLAR_HTTP_ROOT=           # optional, e.g. /mylar

# Mylar3 Authentication (needed for retagging)
# Option 1: Provide credentials for auto-login
MYLAR_USERNAME=
MYLAR_PASSWORD=

# Option 2: Session cookie (saved automatically by `m3 mylar-login`)
MYLAR_SESSION=

# Rate limiting (default: 180/hr — ComicVine hard cap is 200/hr)
MYLAR_RATE_LIMIT=180

# Cloudflare Access (only needed when Mylar is behind CF Access)
CF_AUTHORIZATION=          # paste value from cf-login command
